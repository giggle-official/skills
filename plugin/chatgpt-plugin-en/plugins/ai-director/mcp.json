{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "giggle-director": {
      "type": "streamable-http",
      "url": "https://director.ggltest.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "director-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "director:mcp"
            ]
          }
        }
      }
    }
  }
}
